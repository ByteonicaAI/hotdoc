    {
      "id": "kubectl-config-set-namespace",
      "title": "Set default namespace",
      "syntax": "kubectl config set-context --current --namespace=<name>",
      "description": "Set the current context's default namespace.",
      "examples": [
        {
          "description": "Use app namespace by default",
          "code": "kubectl config set-context --current --namespace=app"
        }
      ],
