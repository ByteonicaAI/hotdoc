        }
      ],
      "tags": ["nodes", "cluster", "get"],
      "source": "official",
      "source_url": "https://kubernetes.io/docs/reference/kubectl/"
    },
    {
      "id": "kubectl-get-ingress",
      "title": "List ingresses",
      "syntax": "kubectl get ingress",
      "description": "List ingress resources in a namespace.",
      "examples": [
        {
          "description": "Show ingress resources",
          "code": "kubectl get ingress -n app"
        }
      ],
      "tags": ["ingress", "network", "get"],
      "source": "official",
      "source_url": "https://kubernetes.io/docs/reference/kubectl/"
