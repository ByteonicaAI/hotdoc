      "title": "Update Lambda code",
      "syntax": "aws lambda update-function-code --function-name <name> --zip-file <fileb://zip>",
      "description": "Upload new deployment package bytes for a Lambda function.",
      "examples": [
        {
          "description": "Deploy local zip",
          "code": "aws lambda update-function-code --function-name api --zip-file fileb://function.zip"
        }
      ],
      "tags": ["lambda", "deploy", "zip"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
