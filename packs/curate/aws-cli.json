      "title": "Invalidate CloudFront paths",
      "syntax": "aws cloudfront create-invalidation --distribution-id <id> --paths <paths>",
      "description": "Create an invalidation request for cached CloudFront objects.",
      "examples": [
        {
          "description": "Invalidate all paths",
          "code": "aws cloudfront create-invalidation --distribution-id E123456789 --paths '/*'"
        }
      ],
      "tags": ["cloudfront", "cache", "invalidate"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
