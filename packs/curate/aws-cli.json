{
  "id": "aws-cli",
  "name": "aws-cli",
  "version": "1.0.0",
  "source": "curated for hotdoc M2 (AWS CLI v2 common workflows; verified against official reference)",
  "license": "MIT",
  "homepage": "https://docs.aws.amazon.com/cli/latest/reference/",
  "entries": [
    {
      "id": "aws-s3-ls",
      "title": "s3 ls list",
      "syntax": "aws s3 ls, aws s3 ls s3://bucket/, aws s3 ls s3://bucket/prefix --recursive",
      "description": "List S3 buckets or objects in a bucket.",
      "examples": [
        {
          "description": "list bucket contents recursively",
          "code": "aws s3 ls s3://my-bucket/logs/ --recursive"
        }
      ],
      "tags": ["s3", "listing"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/s3/ls.html"
    },
    {
      "id": "aws-s3-cp",
      "title": "s3 cp copy",
      "syntax": "aws s3 cp file s3://bucket/, aws s3 cp s3://bucket/key local_file, aws s3 cp --recursive",
      "description": "Copy files to/from S3 buckets.",
      "examples": [
        {
          "description": "copy directory to S3",
          "code": "aws s3 cp local_dir s3://my-bucket/remote_dir --recursive"
        }
      ],
      "tags": ["s3", "transfer"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/s3/cp.html"
    },
    {
      "id": "aws-s3-rm",
      "title": "s3 rm remove",
      "syntax": "aws s3 rm s3://bucket/key, aws s3 rm s3://bucket --recursive",
      "description": "Delete objects from S3 buckets.",
      "examples": [
        {
          "description": "remove objects with prefix",
          "code": "aws s3 rm s3://my-bucket/logs/ --recursive --exclude \"*.txt\""
        }
      ],
      "tags": ["s3", "deletion"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/s3/rm.html"
    },
    {
      "id": "aws-ec2-describe",
      "title": "ec2 describe instances",
      "syntax": "aws ec2 describe-instances, aws ec2 describe-instances --filters Name=state.name,Values=running",
      "description": "List and filter EC2 instances.",
      "examples": [
        {
          "description": "describe running instances",
          "code": "aws ec2 describe-instances --filters Name=instance-state-name,Values=running"
        }
      ],
      "tags": ["ec2", "instances"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/ec2/describe-instances.html"
    },
    {
      "id": "aws-lambda-invoke",
      "title": "lambda invoke",
      "syntax": "aws lambda invoke --function-name name --payload json outfile",
      "description": "Invoke a Lambda function synchronously.",
      "examples": [
        {
          "description": "invoke with payload",
          "code": "aws lambda invoke --function-name my-function --payload '{\"key\":\"value\"}' response.json"
        }
      ],
      "tags": ["lambda", "functions"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/lambda/invoke.html"
    },
    {
      "id": "aws-iam-create-user",
      "title": "iam create-user",
      "syntax": "aws iam create-user --user-name name",
      "description": "Create a new IAM user.",
      "examples": [
        {
          "description": "create user",
          "code": "aws iam create-user --user-name alice"
        }
      ],
      "tags": ["iam", "users"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/iam/create-user.html"
    },
    {
      "id": "aws-iam-attach-policy",
      "title": "iam attach-user-policy",
      "syntax": "aws iam attach-user-policy --user-name name --policy-arn arn",
      "description": "Attach a policy to an IAM user.",
      "examples": [
        {
          "description": "attach policy to user",
          "code": "aws iam attach-user-policy --user-name alice --policy-arn arn:aws:iam::aws:policy/AmazonS3ReadOnlyAccess"
        }
      ],
      "tags": ["iam", "policies"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/iam/attach-user-policy.html"
    },
    {
      "id": "aws-dynamodb-scan",
      "title": "dynamodb scan",
      "syntax": "aws dynamodb scan --table-name table, aws dynamodb scan --table-name table --filter-expression",
      "description": "Scan a DynamoDB table for items.",
      "examples": [
        {
          "description": "scan table with filter",
          "code": "aws dynamodb scan --table-name users --filter-expression 'age > :val' --expression-attribute-values '{\":val\":{\"N\":\"18\"}}'"
        }
      ],
      "tags": ["dynamodb", "tables"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/dynamodb/scan.html"
    },
    {
      "id": "aws-dynamodb-query",
      "title": "dynamodb query",
      "syntax": "aws dynamodb query --table-name table --key-condition-expression",
      "description": "Query a DynamoDB table by partition key.",
      "examples": [
        {
          "description": "query table",
          "code": "aws dynamodb query --table-name users --key-condition-expression 'id = :id' --expression-attribute-values '{\":id\":{\"S\":\"user123\"}}'"
        }
      ],
      "tags": ["dynamodb", "tables"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/dynamodb/query.html"
    },
    {
      "id": "aws-cloudformation-deploy",
      "title": "cloudformation deploy",
      "syntax": "aws cloudformation deploy --template-file template.json --stack-name name",
      "description": "Deploy a CloudFormation stack.",
      "examples": [
        {
          "description": "deploy stack",
          "code": "aws cloudformation deploy --template-file infra.json --stack-name my-stack --capabilities CAPABILITY_IAM"
        }
      ],
      "tags": ["cloudformation", "infrastructure"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/cloudformation/deploy.html"
    },
    {
      "id": "aws-cloudformation-describe",
      "title": "cloudformation describe-stacks",
      "syntax": "aws cloudformation describe-stacks --stack-name name",
      "description": "Get information about a CloudFormation stack.",
      "examples": [
        {
          "description": "describe stack",
          "code": "aws cloudformation describe-stacks --stack-name my-stack"
        }
      ],
      "tags": ["cloudformation", "infrastructure"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/cloudformation/describe-stacks.html"
    },
    {
      "id": "aws-rds-describe",
      "title": "rds describe-db-instances",
      "syntax": "aws rds describe-db-instances, aws rds describe-db-instances --db-instance-identifier name",
      "description": "List RDS database instances.",
      "examples": [
        {
          "description": "describe database",
          "code": "aws rds describe-db-instances --db-instance-identifier my-database"
        }
      ],
      "tags": ["rds", "databases"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/rds/describe-db-instances.html"
