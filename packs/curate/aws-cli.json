    {
      "id": "aws-logs-describe",
      "title": "logs describe-log-groups",
      "syntax": "aws logs describe-log-groups, aws logs describe-log-streams --log-group-name name",
      "description": "List CloudWatch log groups and streams.",
      "examples": [
        {
          "description": "list log streams",
          "code": "aws logs describe-log-streams --log-group-name /aws/lambda/my-function"
        }
      ],
      "tags": ["cloudwatch", "logging"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/logs/describe-log-groups.html"
    },
    {
      "id": "aws-logs-filter",
      "title": "logs filter-log-events",
      "syntax": "aws logs filter-log-events --log-group-name name --filter-pattern pattern",
      "description": "Search logs in a log group.",
      "examples": [
        {
          "description": "filter logs for errors",
          "code": "aws logs filter-log-events --log-group-name /app/logs --filter-pattern 'ERROR'"
        }
      ],
      "tags": ["cloudwatch", "logging"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/logs/filter-log-events.html"
    },
    {
      "id": "aws-cli-configure",
      "title": "configure credentials",
      "syntax": "aws configure, aws configure --profile profile_name",
      "description": "Set up AWS credentials and region.",
      "examples": [
        {
          "description": "configure with profile",
          "code": "aws configure --profile my-profile"
        }
      ],
      "tags": ["config", "authentication"],
      "aliases": [],
      "source": "curated",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/configure/index.html"
    },
    {
      "id": "aws-sts-get-caller-identity",
      "title": "Show current AWS identity",
      "syntax": "aws sts get-caller-identity",
      "description": "Return the account, user ID, and ARN for the active credentials.",
      "examples": [
        {
          "description": "Verify active credentials",
          "code": "aws sts get-caller-identity"
        }
      ],
      "tags": ["sts", "identity", "auth"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
    },
    {
      "id": "aws-s3-sync",
      "title": "Sync S3 prefixes",
      "syntax": "aws s3 sync <src> <dest>",
      "description": "Recursively copy new and changed files between local paths and S3 prefixes.",
      "examples": [
        {
          "description": "Sync build assets to S3",
          "code": "aws s3 sync ./dist s3://my-bucket/dist --delete"
        }
      ],
      "tags": ["s3", "sync", "files"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
    },
    {
      "id": "aws-s3-mb",
      "title": "Create S3 bucket",
      "syntax": "aws s3 mb s3://<bucket>",
      "description": "Create an S3 bucket using the high-level s3 command.",
      "examples": [
        {
          "description": "Create a bucket",
          "code": "aws s3 mb s3://my-hotdoc-bucket"
        }
      ],
      "tags": ["s3", "bucket", "create"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
    },
    {
      "id": "aws-s3-presign",
      "title": "Create a presigned S3 URL",
      "syntax": "aws s3 presign s3://<bucket>/<key>",
      "description": "Generate a temporary signed URL for an S3 object.",
      "examples": [
        {
          "description": "Presign an object for one hour",
          "code": "aws s3 presign s3://my-bucket/report.pdf --expires-in 3600"
        }
      ],
      "tags": ["s3", "presign", "url"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
    },
    {
      "id": "aws-ec2-start-instances",
      "title": "Start EC2 instances",
      "syntax": "aws ec2 start-instances --instance-ids <ids>",
      "description": "Start one or more stopped EC2 instances.",
      "examples": [
        {
          "description": "Start one instance",
          "code": "aws ec2 start-instances --instance-ids i-0123456789abcdef0"
        }
      ],
      "tags": ["ec2", "instance", "start"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
    },
    {
      "id": "aws-ec2-stop-instances",
      "title": "Stop EC2 instances",
      "syntax": "aws ec2 stop-instances --instance-ids <ids>",
      "description": "Stop one or more running EC2 instances.",
      "examples": [
        {
          "description": "Stop one instance",
          "code": "aws ec2 stop-instances --instance-ids i-0123456789abcdef0"
        }
      ],
      "tags": ["ec2", "instance", "stop"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
    },
    {
      "id": "aws-ec2-describe-security-groups",
      "title": "Describe security groups",
      "syntax": "aws ec2 describe-security-groups",
      "description": "List EC2 security groups and their ingress/egress rules.",
      "examples": [
        {
          "description": "Find groups by name",
          "code": "aws ec2 describe-security-groups --group-names web"
        }
      ],
      "tags": ["ec2", "security group", "network"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
    },
    {
      "id": "aws-ecr-login",
      "title": "Log Docker into ECR",
      "syntax": "aws ecr get-login-password | docker login --username AWS --password-stdin <registry>",
      "description": "Get an ECR auth token and pass it to Docker login.",
      "examples": [
        {
          "description": "Authenticate Docker to ECR",
          "code": "aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 123456789012.dkr.ecr.us-east-1.amazonaws.com"
        }
      ],
      "tags": ["ecr", "docker", "auth"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
    },
    {
      "id": "aws-ecs-update-service",
      "title": "Update ECS service",
      "syntax": "aws ecs update-service --cluster <cluster> --service <service>",
      "description": "Modify or force a new deployment of an ECS service.",
      "examples": [
        {
          "description": "Force ECS redeploy",
          "code": "aws ecs update-service --cluster prod --service api --force-new-deployment"
        }
      ],
      "tags": ["ecs", "service", "deploy"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
    },
    {
      "id": "aws-secretsmanager-get-secret-value",
      "title": "Read a secret",
      "syntax": "aws secretsmanager get-secret-value --secret-id <id>",
      "description": "Retrieve the current value for an AWS Secrets Manager secret.",
      "examples": [
        {
          "description": "Get a secret string",
          "code": "aws secretsmanager get-secret-value --secret-id prod/db --query SecretString --output text"
        }
      ],
      "tags": ["secretsmanager", "secret", "read"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
    },
