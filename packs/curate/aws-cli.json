      "id": "aws-ssm-get-parameter",
      "title": "Read SSM parameter",
      "syntax": "aws ssm get-parameter --name <name>",
      "description": "Retrieve a Systems Manager Parameter Store value.",
      "examples": [
        {
          "description": "Get decrypted secure string",
          "code": "aws ssm get-parameter --name /prod/db/password --with-decryption"
        }
      ],
      "tags": ["ssm", "parameter", "secret"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
    },
    {
      "id": "aws-ssm-start-session",
      "title": "Start SSM shell session",
      "syntax": "aws ssm start-session --target <instance-id>",
      "description": "Open an interactive Session Manager shell to a managed instance.",
      "examples": [
        {
          "description": "Connect to an instance without SSH",
          "code": "aws ssm start-session --target i-0123456789abcdef0"
        }
      ],
      "tags": ["ssm", "session", "shell"],
      "aliases": [],
      "source": "official",
      "source_url": "https://docs.aws.amazon.com/cli/latest/reference/"
