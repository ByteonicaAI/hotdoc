      "expected_first": "git-reset-soft-head-1",
      "acceptable_top3": ["git-reset-soft-head-1", "git-stash"],
      "adversarial": true,
      "_comment": "currently ranks git-reset-soft-head-1 first (correct), but git-stash is still 2nd. 5.3 rewrite must keep git-reset-soft-head-1 first AND drop unrelated git cards out of the top 3."
