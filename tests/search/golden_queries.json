      "query": "git reset",
      "expected_first": "git-stash",
      "acceptable_top3": ["git-stash"],
      "adversarial": true,
      "_comment": "currently ranks git-stash above reset cards because the tool token dominates. 5.3 rewrite must return git-reset-soft-head-1 (or git-reset-hard-head) — a reset query must rank a reset card first."
    },
    {
      "query": "reset git",
      "expected_first": "git-stash",
      "acceptable_top3": ["git-stash"],
      "adversarial": true,
      "_comment": "currently ranks git-stash above reset cards; query order should not affect outcome. 5.3 rewrite must return git-reset-soft-head-1 for both 'git reset' and 'reset git'."
    },
